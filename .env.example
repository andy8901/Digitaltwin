# ---- Neosky Live Twin settings (copy to .env and change every secret) ----

# Sign-in for the web page. Either one password for the user "admin"...
TWIN_PASSWORD=change-this-password
# ...or several users: name:password;name:password
# TWIN_USERS=ops:pass1;engineering:pass2

# Long random string that signs login cookies (python -c "import secrets; print(secrets.token_hex(32))")
TWIN_SECRET_KEY=

# Shared secret every field relay sends (--token)
TWIN_INGEST_TOKEN=change-this-ingest-token
# Password field relays use to publish camera video (--video-pass)
TWIN_VIDEO_PUBLISH_PASS=change-this-video-password

# Public DNS name of the server (Caddy gets an HTTPS certificate for it; WebRTC video announces it)
TWIN_DOMAIN=twin.example.com
PUBLIC_HOST=twin.example.com

# Time zone for "today" and the clock
TWIN_TZ=Asia/Kolkata

# Optional: model names for MSNs heard without one, e.g. 064:Tavas,101:Nimble
TWIN_MODEL_MAP=

# Optional: raw MAVLink over UDP (GCS forwarding straight to the server on a LAN/VPN). 0 = off.
TWIN_UDP_PORT=0
# Names for MAVLink system ids heard over UDP: 1:064,2:101
TWIN_SYSID_MAP=

# When a drone counts as stale / offline, and when a flight with a lost link is closed (seconds)
TWIN_STALE_S=3
TWIN_OFFLINE_S=15
TWIN_LOST_CLOSE_S=900

# Demo planner: your own OpenStreetMap Overpass server (optional; public servers are used otherwise)
TWIN_OVERPASS_URL=
